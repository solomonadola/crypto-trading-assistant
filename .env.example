# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIRESTORE_WRITES: set to "off" to make this copy of the app read-only
# against Firestore. It still loads the shared trade history, but its own
# trades (including auto-pilot deploys) stay in this browser. Every copy of the
# app - hosted, local dev, test runs - shares one production database, so use
# this for local development and any testing. Put it in .env.local.
# VITE_FIRESTORE_WRITES=off

# VITE_TRADING_SERVER_URL: the hosted app's URL (no trailing slash). Makes
# this copy - e.g. a local dev server - follow the hosted 24/7 trading server:
# it shows the server's trade list and does not trade on its own while that
# server is running. Leave unset on the hosted app itself.
# VITE_TRADING_SERVER_URL=https://your-app.run.app

# BACKEND_URL: for a local dev server (`bun run dev`) following the hosted
# app: /api is forwarded there, so this copy shows the hosted server's trades
# and its buttons act on it.
# BACKEND_URL=https://your-app.run.app

# VITE_BROWSER_TRADING: 'on' lets a page trade by itself when no 24/7 server
# is reachable. Off by default: without a server a page only displays.
# VITE_BROWSER_TRADING=on
