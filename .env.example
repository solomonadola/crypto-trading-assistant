# Local settings go in .env.local (ignored by git).

# PORT: where the engine serves the page and the API (default 3000).
# PORT=3000

# ENGINE_DB_PATH: the SQLite database (default data/engine/engine.db).
# ENGINE_DB_PATH=data/engine/engine.db

# ENGINE_CONFIG: the engine config file (default engine/config/config.yaml).
# ENGINE_CONFIG=engine/config/config.yaml
