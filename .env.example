# Local settings go in .env.local (ignored by git). On AI Studio, set them as
# secrets / environment variables.

# ALLOWED_EMAILS: Google accounts that may sign in, comma-separated. When set,
# the dashboard and every API call (except /api/health) need a sign-in. Leave
# unset for local development. Set it on any hosted copy.
# ALLOWED_EMAILS=you@example.com

# BACKUP_TARGET: firestore | file. Production defaults to firestore (the trade
# log survives a Cloud Run restart); development defaults to file.
# BACKUP_TARGET=firestore

# ENGINE_NAMESPACE: which backup a copy uses. Production defaults to "hosted",
# development to "local", so a local copy never touches the hosted one's data.
# ENGINE_NAMESPACE=local

# PORT: where the engine serves the page and the API (default 3000).
# PORT=3000

# ENGINE_DB_PATH: the SQLite database (default data/engine/engine.db).
# ENGINE_DB_PATH=data/engine/engine.db

# ENGINE_CONFIG: the engine config file (default engine/config/config.yaml).
# ENGINE_CONFIG=engine/config/config.yaml
