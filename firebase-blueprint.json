{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and quant bot preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "riskTolerance": { "type": "string", "enum": ["CONSERVATIVE", "MODERATE", "AGGRESSIVE", "HFT_EXTREME"], "description": "Risk profile" },
        "autoPilotEnabled": { "type": "boolean", "description": "Autopilot status" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Quant HFT trade execution record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Trade ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "symbol": { "type": "string", "description": "Trading pair e.g. BTCUSDT, ETHUSDT" },
        "side": { "type": "string", "enum": ["BUY", "SELL"], "description": "Order side" },
        "type": { "type": "string", "enum": ["MARKET", "LIMIT", "POST_ONLY"], "description": "Order execution type" },
        "price": { "type": "number", "description": "Execution fill price" },
        "size": { "type": "number", "description": "Quantity executed" },
        "volumeUsdt": { "type": "number", "description": "Notional value in USDT" },
        "pnl": { "type": "number", "description": "Realized Profit and Loss" },
        "pnlPercentage": { "type": "number", "description": "Percentage gain or loss" },
        "fee": { "type": "number", "description": "Maker/taker fee deducted" },
        "strategy": { "type": "string", "description": "Algorithm or trigger name" },
        "regime": { "type": "string", "description": "Market regime e.g. VOLATILE_EXPANSION, LOW_VOL_CONSOLIDATION" },
        "latencyMs": { "type": "number", "description": "Execution latency in milliseconds" },
        "timestamp": { "type": "number", "description": "Epoch timestamp in milliseconds" },
        "status": { "type": "string", "enum": ["FILLED", "PARTIALLY_FILLED", "CANCELLED", "CLOSED"], "description": "Execution status" }
      },
      "required": ["id", "userId", "symbol", "side", "price", "size", "timestamp", "status"]
    },
    "Signal": {
      "title": "Signal",
      "description": "Real-time algorithmic scanner and order flow detection signal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Signal ID" },
        "userId": { "type": "string", "description": "User UID who generated or owns signal" },
        "symbol": { "type": "string", "description": "Trading pair" },
        "score": { "type": "number", "description": "Composite quantitative confidence score (-100 to +100)" },
        "confidence": { "type": "number", "description": "0-100% confidence" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT", "NEUTRAL"], "description": "Suggested trade direction" },
        "orderFlowImbalance": { "type": "number", "description": "Delta ratio of bid/ask imbalance" },
        "spreadBps": { "type": "number", "description": "Bid-ask spread in basis points" },
        "marketRegime": { "type": "string", "description": "Market regime descriptor" },
        "triggerReason": { "type": "string", "description": "Formulaic rationale" },
        "timestamp": { "type": "number", "description": "Signal creation epoch" }
      },
      "required": ["id", "symbol", "score", "direction", "timestamp"]
    },
    "BankrollSnapshot": {
      "title": "BankrollSnapshot",
      "description": "Historical snapshot of quant bankroll and capital efficiency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Snapshot ID" },
        "userId": { "type": "string", "description": "User UID" },
        "balance": { "type": "number", "description": "Current wallet cash balance" },
        "equity": { "type": "number", "description": "Total equity including unrealized PnL" },
        "availableMargin": { "type": "number", "description": "Available free margin" },
        "allocatedMargin": { "type": "number", "description": "Allocated margin in positions" },
        "dailyPnl": { "type": "number", "description": "Daily total PnL" },
        "dailyDrawdownPct": { "type": "number", "description": "Peak-to-trough daily drawdown %" },
        "activePositionsCount": { "type": "number", "description": "Number of open active positions" },
        "timestamp": { "type": "number", "description": "Epoch timestamp" }
      },
      "required": ["id", "userId", "balance", "equity", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Autopilot cycle audit and consolidation loss recorder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log ID" },
        "userId": { "type": "string", "description": "User UID" },
        "category": { "type": "string", "enum": ["CONSOLIDATION_LOSS", "PACING_GUARD", "CIRCUIT_BREAKER", "CYCLE_TICK", "ORDER_FLOW"], "description": "Category" },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL", "PROTECTION_TRIGGERED"], "description": "Severity level" },
        "message": { "type": "string", "description": "Audit event description" },
        "metadata": { "type": "string", "description": "JSON serialized diagnostic data" },
        "timestamp": { "type": "number", "description": "Timestamp" }
      },
      "required": ["id", "userId", "category", "severity", "message", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile and configurations"
    },
    "/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "User executed quantitative and HFT trades"
    },
    "/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "Quantitative market signals generated by scanner"
    },
    "/bankroll_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/BankrollSnapshot" },
      "description": "Historical snapshots of bankroll equity and risk metrics"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Diagnostics, consolidation loss logs and autopilot events"
    }
  }
}
